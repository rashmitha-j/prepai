{
  "name": "prepai",
  "version": "1.0.0",
  "private": true,
  "description": "PrepAI — AI Interview Coach (React + Express + FastAPI + RAG)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "npm install && node scripts/setup-ai.js",
    "setup:ai": "node scripts/setup-ai.js",
    "dev": "concurrently -k -n api,ai,web -c blue,magenta,green \"npm:dev:backend\" \"npm:dev:ai\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:ai": "node scripts/run-ai.js dev",
    "seed": "npm run seed -w backend",
    "test": "npm run test:backend && npm run test:frontend && npm run test:ai",
    "test:backend": "npm test -w backend",
    "test:frontend": "npm test -w frontend",
    "test:ai": "node scripts/run-ai.js test",
    "lint": "npm run lint:backend && npm run lint:frontend && npm run lint:ai",
    "lint:backend": "npm run lint -w backend",
    "lint:frontend": "npm run lint -w frontend",
    "lint:ai": "node scripts/run-ai.js lint",
    "build": "npm run build -w frontend",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
