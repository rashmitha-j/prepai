# ---- Service ----
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
# Shared secret the Node backend sends as X-Internal-Token (required in production).
# Must match AI_SERVICE_TOKEN in backend/.env. Generate: python -c "import secrets;print(secrets.token_hex(32))"
AI_SERVICE_TOKEN=

# ---- LLM provider: ollama | openai | gemini | groq | openai_compatible ----
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=replace_me
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Used when AI_PROVIDER is an API provider (OpenAI-compatible wire format).
# API_BASE_URL may be left empty for openai / gemini / groq presets.
API_BASE_URL=
API_KEY=
API_MODEL=
API_EMBEDDING_MODEL=

LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1500

# ---- Embeddings: auto | ollama | api | hash ----
# hash = deterministic local lexical embedder (no model download; lower quality)
EMBEDDING_PROVIDER=auto

# ---- Vector store: chroma | local ----
VECTOR_STORE=chroma
VECTOR_DB_PATH=./data/vector_db
RAG_TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150
# Knowledge base indexed at startup when the vector index is missing documents ("" disables)
RAG_BOOTSTRAP_DIR=../backend/src/seed/knowledge
