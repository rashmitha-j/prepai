NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/prepai
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent to the AI service (must match ai-service AI_SERVICE_TOKEN). Required in production.
AI_SERVICE_TOKEN=
AI_REQUEST_TIMEOUT_MS=180000
# Set to true when running behind a reverse proxy (Render, Nginx) so rate limits see real client IPs
TRUST_PROXY=false
# Re-index knowledge documents into the vector store on startup when missing
KNOWLEDGE_AUTO_SYNC=true
MAX_UPLOAD_MB=5
# Code execution sandbox: process (local dev) | docker (stronger isolation) | disabled
CODE_RUNNER=process
CODE_RUNNER_DOCKER_IMAGE=gcc:13
# The process runner is refused in production unless this is explicitly true (not recommended)
ALLOW_UNSAFE_CODE_EXECUTION=false
BCRYPT_ROUNDS=12
# Optional: fixed password for `npm run seed -- --demo-user` (otherwise one is generated)
DEMO_USER_PASSWORD=
